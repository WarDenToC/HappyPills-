@page "/prescriber"
@rendermode InteractiveServer
@using MedSafety.Core
@using MedSafety.Core.Enum
@using MedSafety.Core.Models
@using MedSafety.Core.Rules
@using MedSafety.Web.Services
@inject PrescriptionStore Store

<PageTitle>New prescription — MedSafety</PageTitle>

<h3>New prescription</h3>
<p class="text-muted">Synthetic data only — prototype, not for clinical use.</p>

<div class="mb-2">
    <label>Patient</label>
    <select class="form-control" @bind="selectedPatientId">
        <option value="0">Select a patient…</option>
        @foreach (var p in SampleData.Patients)
        {
            <option value="@p.PatientId">@p.Firstname @p.Lastname</option>
        }
    </select>
</div>
<div class="mb-2">
    <label>Drug</label>
    <select class="form-control" @bind="drugName">
        <option value="">Select a drug…</option>
        @foreach (var d in SampleData.Formulary.Entries)
        {
            <option value="@d.DrugName">@d.DrugName (@d.DrugClass)</option>
        }
    </select>
</div>
<div class="mb-2">
    <label>Dose amount</label>
    <input class="form-control" type="number" @bind="doseAmount" />
</div>
<div class="mb-2">
    <label>Dose unit</label>
    <select class="form-control" @bind="doseUnit">
        <option value="@DoseUnit.Mg">mg</option>
        <option value="@DoseUnit.G">g</option>
    </select>
</div>
<div class="mb-2">
    <label>Frequency (times per day)</label>
    <input class="form-control" type="number" @bind="frequency" />
</div>
<div class="mb-2">
    <label>Route</label>
    <input class="form-control" @bind="route" />
</div>
<div class="mb-2">
    <label>Duration</label>
    <input class="form-control" @bind="duration" />
</div>

<button class="btn btn-primary" @onclick="HandleSubmit">Submit prescription</button>

@if (validationErrors.Any())
{
    <div class="alert alert-danger mt-3">
        <strong>Rejected (FR2) — missing or invalid fields:</strong>
        <ul>@foreach (var e in validationErrors) { <li>@e</li> }</ul>
    </div>
}

@if (lastResult is not null)
{
    <div class="mt-4">
        <h4>Safety check result — outcome: @lastResult.Outcome</h4>
        @if (!lastResult.Alerts.Any())
        {
            <div class="alert alert-success">No rules violated.</div>
        }
        @foreach (var alert in lastResult.Alerts)
        {
            <div class="alert @(alert.Severity == Severity.Critical ? "alert-danger" : alert.Severity == Severity.Medium ? "alert-warning" : "alert-secondary")">
                <strong>@alert.RuleType (@alert.Severity)</strong>
                <p class="mb-0">@alert.Message</p>
            </div>
        }
        <p class="text-success mt-2">Submitted to pharmacist review queue.</p>
    </div>
}

@code {
    private int selectedPatientId;
    private string drugName = "";
    private decimal doseAmount;
    private DoseUnit doseUnit = DoseUnit.Mg;
    private int frequency;
    private string route = "";
    private string duration = "";

    private List<string> validationErrors = new();
    private SafetyCheckResult? lastResult;

    private void HandleSubmit()
    {
        validationErrors = new List<string>();
        if (selectedPatientId == 0) validationErrors.Add("Patient is required.");

        var rx = new Prescription(selectedPatientId, drugName, doseUnit, doseAmount, frequency, route, duration);
        validationErrors.AddRange(PrescriptionValidator.Validate(rx, SampleData.Formulary));

        if (validationErrors.Any())
        {
            lastResult = null;
            return;
        }

        var patient = SampleData.Patients.First(p => p.PatientId == selectedPatientId);
        var checker = new SafetyChecker(new IPrescriptionRule[]
        {
            new DoseRangeRule(), new AllergyRule(), new InteractionRule(), new DuplicateRule()
        });

        lastResult = checker.RunChecks(rx, patient, SampleData.Formulary);
        Store.Submit(rx, patient, lastResult);
    }
}