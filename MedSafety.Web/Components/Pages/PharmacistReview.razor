@page "/pharmacist"
@rendermode InteractiveServer
@using MedSafety.Core.Models

<PageTitle>Review queue — MedSafety</PageTitle>

<h3>Review queue</h3>
<p class="text-muted">Fake queue data for UI layout only — will connect to real submitted prescriptions once Data is wired up.</p>

@foreach (var rx in queue)
{
    <div class="card mb-3 p-3">
        <div class="d-flex justify-content-between">
            <div>
                <strong>@rx.PatientName</strong> — @rx.DrugName @rx.DoseAmount@rx.DoseUnit
            </div>
            <span class="badge bg-secondary">@rx.Outcome</span>
        </div>
        <div class="mt-2">
            <button class="btn btn-sm btn-success" @onclick='() => Decide(rx, "Approved")'>Approve</button>
            <button class="btn btn-sm btn-danger" @onclick='() => Decide(rx, "Rejected")'>Reject</button>
        </div>
        @if (rx.Status is not null)
        {
            <p class="mt-2 mb-0"><em>Status: @rx.Status</em></p>
        }
    </div>
}

@code {
    private class QueueItem
    {
        public string PatientName { get; set; } = string.Empty;
        public string DrugName { get; set; } = string.Empty;
        public string DoseAmount { get; set; } = string.Empty;
        public string DoseUnit { get; set; } = string.Empty;
        public Severity Outcome { get; set; }
        public string? Status { get; set; }
    }

    private List<QueueItem> queue = new()
    {
        new() { PatientName = "Kai Ngata", DrugName = "Alphacillin", DoseAmount = "500", DoseUnit = "mg", Outcome = Severity.Critical },
        new() { PatientName = "Riya Sharma", DrugName = "Dolorex", DoseAmount = "500", DoseUnit = "mg", Outcome = Severity.Medium }
    };

    private void Decide(QueueItem rx, string status)
    {
        rx.Status = status;
    }
}