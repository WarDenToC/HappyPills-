@page "/pharmacist"
@rendermode InteractiveServer
@using MedSafety.Core.Enum
@using MedSafety.Web.Services
@inject PrescriptionStore Store

<PageTitle>Review queue — MedSafety</PageTitle>

<h3>Review queue</h3>

@if (!AccessControlService.CanPerform(UserRole.Pharmacist, "ReviewPrescription"))
{
    <div class="alert alert-danger">AccessDenied — this view requires the Pharmacist role.</div>
}
else
{
    @foreach (var rx in Store.All.Where(r => r.Status == "Submitted"))
    {
        <div class="card mb-3 p-3">
            <strong>@rx.Patient.Firstname @rx.Patient.Lastname</strong> — @rx.Prescription.DrugName
            @rx.Prescription.DoseAmount@rx.Prescription.DoseUnit
            <span class="badge bg-secondary ms-2">@rx.SafetyResult.Outcome</span>

            @foreach (var alert in rx.SafetyResult.Alerts)
            {
                <div class="small text-muted">@alert.RuleType: @alert.Message</div>
            }

            @if (rx.SafetyResult.Outcome == Severity.Critical)
            {
                <textarea class="form-control mt-2" placeholder="Override reason (required for Critical)" @bind="overrideReasons[rx.Id]"></textarea>
                <button class="btn btn-sm btn-primary mt-2" @onclick='() => Decide(rx.Id, "Approved")'>Override &amp; approve</button>
            }
            else
            {
                <button class="btn btn-sm btn-success mt-2" @onclick='() => Decide(rx.Id, "Approved")'>Approve</button>
            }
            <button class="btn btn-sm btn-danger mt-2" @onclick='() => Decide(rx.Id, "Rejected")'>Reject</button>

            @if (errors.TryGetValue(rx.Id, out var err))
            {
                <div class="text-danger small mt-1">@err</div>
            }
        </div>
    }
}

@code {
    private Dictionary<int, string?> overrideReasons = new();
    private Dictionary<int, string> errors = new();

    private void Decide(int id, string decision)
    {
        overrideReasons.TryGetValue(id, out var reason);
        var (success, error) = Store.Decide(id, decision, reason);
        if (!success && error is not null)
        {
            errors[id] = error;
        }
        else
        {
            errors.Remove(id);
        }
    }
}