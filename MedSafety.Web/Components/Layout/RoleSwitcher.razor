@implements IDisposable
@inject CurrentUser User
@inject NavigationManager Navigation

<div class="role-switcher">
    <label for="role-select" class="me-2">Acting as:</label>
    <select id="role-select" class="form-select form-select-sm" value="@User.Role.ToString()" @onchange="OnRoleChanged">
        @foreach (var role in Enum.GetValues<Role>())
        {
            <option value="@role">@role</option>
        }
    </select>
    <span class="ms-3 text-muted small">@User.Name</span>
</div>

@code {
    protected override void OnInitialized() => User.Changed += OnUserChanged;

    private void OnUserChanged() => InvokeAsync(StateHasChanged);

    // Switching role always lands on Home, so any page you open next starts fresh
    // and checks permission for the new role.
    private void OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Role>(e.Value?.ToString(), out var role))
        {
            User.SwitchTo(role);
            Navigation.NavigateTo("/");
        }
    }

    public void Dispose() => User.Changed -= OnUserChanged;
}